# --- MinePower Konfiguration (alles OPTIONAL – Plug & Play ohne .env) ---
# Ohne .env gilt: interne DB mit Default-Passwort (nicht von außen erreichbar),
# JWT-Secret wird beim Erststart automatisch erzeugt und in der DB persistiert.
# Für gehärtete Installationen: Datei nach .env kopieren und Werte setzen.

# Eigenes DB-Passwort (empfohlen für Produktion)
#POSTGRES_PASSWORD=change-me-please

# Eigenes JWT-Secret statt Auto-Generierung (z. B. `openssl rand -hex 32`)
#JWT_SECRET=

# Schlüssel für gespeicherte Zugangsdaten (Tokens, Passwörter der Geräte).
# Leer = Schlüsseldatei im Volume app_data. Sicher aufbewahren: ohne ihn
# sind gespeicherte Zugangsdaten nicht mehr lesbar.
#MINEPOWER_SECRET_KEY=

# KEBA P30 (UDP): Antworten kommen an Port 7090 – in docker-compose.yml
# unter ports zusätzlich "7090:7090/udp" eintragen.

# Web-GUI-Port am Host (Default 8080)
#HTTP_PORT=8080

# Image (Standard: marwinrentz1/minepower:latest)
#MINEPOWER_IMAGE=marwinrentz1/minepower:latest

# Demo-/Simulationsmodus beim Erststart: legt eine komplette simulierte
# Anlage an – App ohne Hardware erlebbar (Demo-Login wird geloggt).
#DEMO_MODE=true

# Regelintervall in Sekunden (2–5 empfohlen; später im GUI änderbar)
#CONTROL_INTERVAL_S=3

#LOG_LEVEL=INFO

# Headless-Konfiguration: Pfad zu gemounteter JSON-Datei (docs/headless.md)
#HEADLESS_CONFIG=/config/minepower.json

# Optionaler MQTT-Broker (docker compose --profile mqtt up -d)
#MQTT_URL=mqtt://mqtt:1883
